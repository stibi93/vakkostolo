# Publikus böngészőkonfiguráció a /host belépéshez. A demo ezek nélkül is fut.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcionális: a meghívó link eredete (pl. http://192.168.1.10:5173). Az `npm run dev:lan` beállítja.
VITE_PUBLIC_APP_URL=
# Titkos/service_role/AI API-kulcsot soha ne adj meg VITE_ változóban.
# Google provider és engedélyezett callbackcímek: docs/auth.md.
